# ============================================
# Px Lite Backend - Multi-stage build
# ============================================

# Stage 1: Build
FROM node:20-alpine AS build

# Install build tools for native modules (better-sqlite3)
RUN sed -i 's#https\?://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories && \
    apk add --no-cache python3 make g++

WORKDIR /app
COPY server/package.json server/package-lock.json* ./
RUN npm config set registry https://registry.npmmirror.com && npm ci
COPY server/ .
RUN npx tsc --outDir dist

# Stage 2: Production
FROM node:20-alpine

WORKDIR /app

# Install runtime deps for Chromium/Playwright and CJK font rendering.
# PPT export no longer depends on Python/Pillow; the SVG→PPTX path is TS/OOXML.
RUN sed -i 's#https\?://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories \
    && apk add --no-cache \
      ca-certificates tzdata \
      cairo pango gdk-pixbuf chromium nss freetype harfbuzz font-noto-cjk

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# Runtime AI helper skills/scripts are loaded from /app/ai-helper/skills.
# Generated artifacts, project workdirs, and logs are created at runtime and are
# intentionally not copied from the build context.
COPY --from=build /app/ai-helper/skills ./ai-helper/skills

# Create writable runtime directories for SQLite, backend logs, and AI helper outputs.
RUN mkdir -p /app/data /app/logs /app/ai-helper/generated /app/ai-helper/projects /app/ai-helper/logs && \
    chown -R nodejs:nodejs /app/data /app/logs /app/ai-helper

USER nodejs

ENV NODE_ENV=production
ENV PORT=3001
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Database mode is selected at runtime.
# - Local docker-compose sets DB_CLIENT=sqlite and DB_PATH=/app/data/pxlite.db.
# - Production should set DB_CLIENT=postgres plus DATABASE_URL, or at least DATABASE_URL.
# Do not bake production database credentials into the image.

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3001/api/ready || exit 1

EXPOSE 3001

CMD ["node", "dist/index.js"]
