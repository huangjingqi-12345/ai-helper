# ============================================
# Px Lite Backend - Multi-stage build
# ============================================

# Stage 1: Build
FROM node:20-alpine AS build

# Install build tools for native modules (better-sqlite3)
RUN apk add --no-cache python3 make g++

WORKDIR /app
COPY server/package.json server/package-lock.json* ./
RUN npm config set registry https://registry.npmmirror.com && npm ci
COPY server/ .
RUN npx tsc --outDir dist

# Stage 2: Production
FROM node:20-alpine

WORKDIR /app

# Runtime deps only (better-sqlite3 native binary just needs libstdc++ which is in node:alpine)
RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

# Create data directory for SQLite
RUN mkdir -p /app/data && chown -R nodejs:nodejs /app/data
# Create logs directory
RUN mkdir -p /app/logs && chown -R nodejs:nodejs /app/logs

USER nodejs

ENV NODE_ENV=production
ENV PORT=3001
# Database mode is selected at runtime.
# - Local docker-compose sets DB_CLIENT=sqlite and DB_PATH=/app/data/pxlite.db.
# - Production should set DB_CLIENT=postgres plus DATABASE_URL, or at least DATABASE_URL.
# Do not bake production database credentials into the image.

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3001/api/ready || exit 1

EXPOSE 3001

CMD ["node", "dist/index.js"]
