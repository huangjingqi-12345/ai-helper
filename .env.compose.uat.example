# Copy this file to .env.compose.uat.local and fill in real UAT values.
# .env.compose.uat.local is ignored by git.

# Docker Compose deployment identity and published ports.
DEPLOY_ENV=uat
COMPOSE_PROJECT_NAME=pxlite-uat
FRONTEND_HOST_PORT=31004

# PostgreSQL runtime database for the backend.
# Use a separate database/schema from DEV/SIT.
DATABASE_URL=postgresql://px_uat:change-me@postgres-host:5432/px_uat
DATABASE_SSL=false
PGSSLMODE=disable
PG_POOL_MAX=10

# UAT should be production-like by default.
RUN_DEMO_SEED=false
ALLOW_DEMO_AUTH=false

# DX content detail API for approval attachments.
DX_API_BASE_URL=https://dx-uat.example.com/api
DX_CONTENT_DETAIL_PATH_TEMPLATE=/content/{contentId}
DX_API_TOKEN=
DX_API_KEY=
DX_API_TIMEOUT_MS=5000
DX_CONTENT_FALLBACK=none
