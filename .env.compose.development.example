# Local Docker Compose example.
# docker-compose.yml already sets the backend to SQLite.
DEPLOY_ENV=local
FRONTEND_HOST_PORT=9973

# Optional DX API integration for approval attachments.
# Leave empty for local demo fallback to SQLite content cache.
DX_API_BASE_URL=
DX_DOCTORS_PATH=/api/px/doctors
DX_CONTENT_DETAIL_PATH_TEMPLATE=/content/{contentId}
DX_API_TOKEN=
DX_API_KEY=
DX_API_TIMEOUT_MS=5000
DX_CONTENT_FALLBACK=local

# Optional CX patient-side aggregate stats integration.
# Leave empty for local demo data.
CX_API_BASE_URL=
CX_PHARMA_ACCESS_TOKEN=
CX_API_TIMEOUT_MS=10000
CX_SYNC_HOUR=2
