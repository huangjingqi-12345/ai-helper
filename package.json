{
  "name": "px-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "bash scripts/dev.sh",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && cd server && npx tsc",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:server": "cd server && npm run test",
    "test:all": "bash scripts/test.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "docker:dev": "bash scripts/docker-dev.sh",
    "docker:build": "bash scripts/docker-build.sh",
    "docker:up": "bash scripts/docker-dev.sh",
    "docker:down": "docker compose --env-file .env.compose.development.local down",
    "docker:logs": "docker compose --env-file .env.compose.development.local logs -f",
    "docker:prod": "bash scripts/deploy.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:sit": "bash scripts/deploy.sh sit",
    "deploy:uat": "bash scripts/deploy.sh uat"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.14.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
