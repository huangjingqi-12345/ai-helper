# Copy this file to .env.compose.sit.local and fill in real SIT values.
# .env.compose.sit.local is ignored by git.

# Docker Compose deployment identity and published ports.
DEPLOY_ENV=sit
COMPOSE_PROJECT_NAME=pxlite-sit
FRONTEND_HOST_PORT=31003

# PostgreSQL runtime database for the backend.
# Use a separate database/schema from DEV/UAT.
DATABASE_URL=postgresql://px_sit:change-me@postgres-host:5432/px_sit
DATABASE_SSL=false
PGSSLMODE=disable
PG_POOL_MAX=10

# SIT should be production-like by default.
RUN_DEMO_SEED=false
ALLOW_DEMO_AUTH=false

# DX content detail API for approval attachments.
DX_API_BASE_URL=https://dx-sit.example.com/api
DX_DOCTORS_PATH=/api/px/doctors
DX_CONTENT_DETAIL_PATH_TEMPLATE=/content/{contentId}
DX_API_TOKEN=
DX_API_KEY=
DX_API_TIMEOUT_MS=5000
DX_CONTENT_FALLBACK=none

# CX patient-side aggregate stats API.
CX_API_BASE_URL=https://cx-sit.example.com
CX_PHARMA_ACCESS_TOKEN=
CX_API_TIMEOUT_MS=10000
CX_SYNC_HOUR=2
