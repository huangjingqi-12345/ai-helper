# Copy this file to .env.compose.production.local and fill in real production values.
# .env.compose.production.local is ignored by git.

# Docker Compose deployment identity and published ports.
DEPLOY_ENV=production
COMPOSE_PROJECT_NAME=pxlite-production
FRONTEND_HOST_PORT=9973

# PostgreSQL runtime database for the backend.
# Use postgresql://, not Python/SQLAlchemy's postgresql+psycopg:// dialect prefix.
DATABASE_URL=postgresql://px_user:change-me@postgres-host:5432/px_database
DATABASE_SSL=false
PGSSLMODE=disable
PG_POOL_MAX=10

# Production-safe defaults.
RUN_DEMO_SEED=false
ALLOW_DEMO_AUTH=false

# DX content detail API for approval attachments.
DX_API_BASE_URL=https://dx.example.com/api
DX_CONTENT_DETAIL_PATH_TEMPLATE=/content/{contentId}
DX_API_TOKEN=
DX_API_KEY=
DX_API_TIMEOUT_MS=5000
DX_CONTENT_FALLBACK=none
