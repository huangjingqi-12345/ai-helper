# Copy this file to .env.compose.dev.local and fill in real DEV values.
# .env.compose.dev.local is ignored by git.

# Docker Compose deployment identity and published ports.
DEPLOY_ENV=dev
COMPOSE_PROJECT_NAME=pxlite-dev
FRONTEND_HOST_PORT=31002

# PostgreSQL runtime database for the backend.
# Use a separate database/schema from SIT/UAT.
DATABASE_URL=postgresql://px_dev:change-me@postgres-host:5432/px_dev
DATABASE_SSL=false
PGSSLMODE=disable
PG_POOL_MAX=10

# DEV can enable demo auth/seed only if the environment is intentionally non-production.
RUN_DEMO_SEED=false
ALLOW_DEMO_AUTH=false

# DX content detail API for approval attachments.
DX_API_BASE_URL=https://dx-dev.example.com/api
DX_DOCTORS_PATH=/api/px/doctors
DX_CONTENT_DETAIL_PATH_TEMPLATE=/content/{contentId}
DX_API_TOKEN=
DX_API_KEY=
DX_API_TIMEOUT_MS=5000
DX_CONTENT_FALLBACK=none
