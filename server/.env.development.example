# Backend local development example.
# Copy to server/.env.development.local if you want an explicit local env file.
NODE_ENV=development
PORT=3001
DB_CLIENT=sqlite
DB_PATH=./data/pxlite.db
RUN_DEMO_SEED=true
RESET_DEMO_DATA=false
ALLOW_DEMO_AUTH=true
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional CX stats sync for local integration testing.
CX_API_BASE_URL=
CX_PHARMA_ACCESS_TOKEN=
CX_API_TIMEOUT_MS=10000
CX_SYNC_HOUR=2

# Embedded PX AI Helper. The helper runs inside this Node backend; no external ai-helper service is required.
POE_API_KEY=
OPENAI_API_KEY=sk-08b509ff8f3444fdad5f2b5601486b9d
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen3.7-max
