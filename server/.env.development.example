# Backend local development example.
# Copy to server/.env.development.local if you want an explicit local env file.
NODE_ENV=development
PORT=3001
DB_CLIENT=sqlite
DB_PATH=./data/pxlite.db
RUN_DEMO_SEED=true
RESET_DEMO_DATA=false
ALLOW_DEMO_AUTH=true
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
