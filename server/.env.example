# RESET_DEMO_DATA=false

# Production: PostgreSQL
# DB_CLIENT=postgres
# DATABASE_URL=postgres://pxlite:change-me@localhost:5432/pxlite
# PG_POOL_MAX=10
# DATABASE_SSL=false
# PGSSLMODE=require

PORT=3001
