# Local development (default): SQLite
# DB_CLIENT=sqlite
# DB_PATH=./data/pxlite.db
# Set to true when you want to wipe and reseed local demo rows on startup.
# RESET_DEMO_DATA=false

# Production: PostgreSQL
# DB_CLIENT=postgres
# Use postgresql:// or postgres://. If you received postgresql+psycopg://
# from Python/SQLAlchemy tooling, remove "+psycopg" for this Node backend.
# DATABASE_URL=postgresql://pxlite:change-me@localhost:5432/pxlite
# PG_POOL_MAX=10
# DATABASE_SSL=false
# PGSSLMODE=require

PORT=3001

# ── DX Integration (content sync + task dispatch) ──
# DX_API_BASE_URL=https://sit-dx.senzco.com
# DOCTOR_SERVER_TOKEN=your-shared-secret-min-32-chars
# DX_API_TIMEOUT_MS=10000

# ── CX Integration (patient-side health-education stats) ──
# CX_API_BASE_URL=https://cx.senzco.com
# CX_PHARMA_ACCESS_TOKEN=your-pharma-access-token
# CX_API_TIMEOUT_MS=10000
# CX_SYNC_HOUR=2  # Hour (0-23) to run daily stats sync

# ── Embedded PX AI Helper (Node/TS) ──
# POE_API_KEY=your-poe-key
# OPENAI_API_KEY=your-openai-compatible-key
# OPENAI_BASE_URL=https://api.poe.com/v1
# TEXT_MODEL=GPT-5.4

# ── AI Helper generated file persistence (Alibaba Cloud OSS) ──
# When configured, generated PNG/PDF/PPTX/HTML/SVG files are uploaded to OSS;
# DB stores conversation text plus OSS file URLs.
# ALI_OSS_ACCESS_KEY_ID=your-access-key-id
# ALI_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# ALI_OSS_BUCKET=your-bucket
# ALI_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# Optional: CDN/custom public domain. If omitted, uses https://<bucket>.<endpoint>/<key>
# ALI_OSS_PUBLIC_BASE_URL=https://cdn.example.com
# Optional object key prefix.
# AI_HELPER_OSS_PREFIX=ai-helper
# Optional: fail generation when upload fails instead of falling back to local URL.
# AI_HELPER_OSS_REQUIRED=false
