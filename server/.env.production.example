# Backend production example for non-Docker deployments.
# Copy to server/.env.production.local or set these in your secret manager.
NODE_ENV=production
PORT=3001
DB_CLIENT=postgres
DATABASE_URL=postgresql://px_user:change-me@postgres-host:5432/px_database
DATABASE_SSL=false
PGSSLMODE=disable
PG_POOL_MAX=10

RUN_DEMO_SEED=false
ALLOW_DEMO_AUTH=false
LOG_LEVEL=info
# CORS_ORIGINS=https://your-production-domain.example

# AI Helper generated file persistence (Alibaba Cloud OSS)
# ALI_OSS_ACCESS_KEY_ID=your-access-key-id
# ALI_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# ALI_OSS_BUCKET=your-bucket
# ALI_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# ALI_OSS_PUBLIC_BASE_URL=https://cdn.example.com
# AI_HELPER_OSS_PREFIX=ai-helper
# AI_HELPER_OSS_REQUIRED=false

# Real production auth should set OIDC values instead of demo auth.
# OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
# OIDC_ISSUER=https://idp.example/
# OIDC_AUDIENCE=px-lite
# REQUIRE_MFA=true
